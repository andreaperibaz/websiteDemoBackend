<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="010-2" author="andreapeib">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="auth_uid" type="UUID">
                <constraints nullable="true"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="phone" type="VARCHAR(255)"/>
            <column name="is_guest" type="BOOLEAN"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>

        <sql>ALTER TABLE users ENABLE ROW LEVEL SECURITY;</sql>

        <sql>
            CREATE POLICY "User can read own record"
            ON users FOR SELECT USING (auth.uid() = auth_uid);
        </sql>

        <sql>
            CREATE POLICY "User can insert own record"
            ON users FOR INSERT
            WITH CHECK (auth.uid() = auth_uid);
        </sql>

        <sql>
            CREATE POLICY "User can update own record"
            ON users FOR UPDATE
            USING (auth.uid() = auth_uid);
        </sql>

        <sql>
            CREATE POLICY "User can delete own record"
            ON users FOR DELETE
            USING (auth.uid() = auth_uid);
        </sql>
    </changeSet>

</databaseChangeLog>
